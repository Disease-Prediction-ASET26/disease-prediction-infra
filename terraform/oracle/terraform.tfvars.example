tenancy_ocid           = "ocid1.tenancy.oc1..replace-me"
compartment_ocid       = "ocid1.tenancy.oc1..replace-me"
region                 = "eu-frankfurt-1"
oci_profile            = "DEFAULT"
budget_alert_email     = "REPLACE_WITH_YOUR_ALERT_EMAIL"
availability_domain    = "REPLACE_WITH_EXACT_TENANCY_AD_NAME"
image_ocid             = "ocid1.image.oc1..replace-with-arm64-linux-image-in-this-region"
ssh_public_key_path    = "C:/Users/your-user/.ssh/disease-prediction-oci.key.pub"
admin_ssh_cidr         = "REPLACE_WITH_YOUR_PUBLIC_IP/32" # Set to null after Tailscale access is verified.
vcn_dns_label          = "REPLACE_WITH_EXISTING_VCN_DNS_LABEL"
subnet_dns_label       = "REPLACE_WITH_EXISTING_SUBNET_DNS_LABEL"
instance_hostname_label = "REPLACE_WITH_EXISTING_VNIC_HOSTNAME_LABEL"
boot_volume_size_gb = 200
vcn_cidr    = "10.0.0.0/16"
subnet_cidr = "10.0.0.0/24"
