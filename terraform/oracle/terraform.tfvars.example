tenancy_ocid        = "ocid1.tenancy.oc1..replace-me"
compartment_ocid    = "ocid1.compartment.oc1..replace-me"
region              = "replace-with-home-region"
oci_profile         = "DEFAULT"
# Optional; unset to use the first availability domain returned by OCI.
# availability_domain = "YOUR-AVAILABILITY-DOMAIN"
image_ocid          = "ocid1.image.oc1..replace-with-ubuntu-24.04-arm64-image-for-this-region"
ssh_public_key_path = "C:/Users/your-user/.ssh/disease-prediction-oci.pub"
admin_ssh_cidr      = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Check the tenancy's existing VCN CIDRs before using these defaults.
# vcn_cidr    = "10.42.0.0/16"
# subnet_cidr = "10.42.10.0/24"
